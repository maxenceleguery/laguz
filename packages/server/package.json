{
  "name": "@laguzjs/server",
  "version": "0.2.0",
  "description": "Server side of laguz: run each root field on its own, stream results, resolve dependent queries in one round trip.",
  "keywords": [
    "batching",
    "dataloader",
    "graphql",
    "ndjson",
    "server",
    "streaming"
  ],
  "homepage": "https://laguz.maxenceleguery.net",
  "bugs": {
    "url": "https://github.com/maxenceleguery/laguz/issues"
  },
  "license": "MIT",
  "author": "Maxence Leguery",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxenceleguery/laguz.git",
    "directory": "packages/server"
  },
  "bin": {
    "laguz-types": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/fixtures"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "bun": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./node": {
      "source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "bun": "./src/node.ts",
      "default": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.node.json && tsc -p tsconfig.cli.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\""
  },
  "peerDependencies": {
    "graphql": ">=16"
  }
}
