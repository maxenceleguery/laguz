{
  "name": "laguz",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxenceleguery/laguz.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '@laguzjs/*' build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "changeset": "changeset",
    "release": "bun run build && changeset publish",
    "demo": "bun bench/server.ts",
    "bench": "bun bench/run.ts && bun bench/features.ts",
    "prepare": "lefthook install",
    "fixtures": "bun packages/server/src/cli.ts packages/server/src/fixtures/schema.graphql --scalar DateTime=string -o packages/server/src/fixtures/schema.generated.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@laguzjs/client": "workspace:*",
    "@laguzjs/server": "workspace:*",
    "@tanstack/react-query": "^5.105.3",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "graphql": "^17.0.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4"
}
